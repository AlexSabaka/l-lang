{
  "name": "l-lang",
  "version": "0.1.0",
  "description": "l-lang implementation for the JavaScript",
  "main": "./dist/index.js",
  "bin": {
    "l-lang": "./dist/cli/index.js"
  },
  "scripts": {
    "start": "ts-node index.ts",
    "parser": "peggy --cache -o ./compiler/frontend/grammar/l-lang.js --format es ./compiler/frontend/grammar/l-lang.pegjs",
    "build": "tsc",
    "test": "ts-node test/runner.ts",
    "test:verbose": "ts-node test/runner.ts --verbose",
    "test:grammar-v2-smoke": "ts-node test/smoke-grammar-v2.ts",
    "test:diff-frontends": "ts-node test/diff-frontends.ts",
    "test:type-errors": "ts-node test/type-errors.ts",
    "test:diagnostics": "ts-node test/diagnostics.ts",
    "test:imports": "ts-node test/imports.ts",
    "test:codegen": "ts-node test/codegen.ts",
    "test:repl": "ts-node test/repl.ts"
  },
  "author": "Alex Sabaka",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "nodemonConfig": {
    "ext": "*.ts,*.js,*.json,*.pegjs,*.lisp",
    "ignore": [
      "**/test/**",
      "**/docs/**"
    ]
  },
  "dependencies": {
    "@babel/types": "^7.25.8",
    "@types/estree": "^1.0.8",
    "@types/node": "^22.7.4",
    "acorn": "^8.14.0",
    "astring": "^1.9.0",
    "chalk": "^4.1.2",
    "chevrotain": "^10.5.0",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "highlight.js": "^11.10.0",
    "peggy": "^5.0.6",
    "pretty-format": "^29.7.0",
    "readline-sync": "^1.4.10",
    "recast": "^0.23.9",
    "source-map": "^0.7.4",
    "typescript": "^5.6.2",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/readline-sync": "^1.4.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2"
  }
}
