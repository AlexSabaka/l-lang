{
  "name": "l-lang",
  "version": "0.1.0",
  "description": "l-lang implementation for the JavaScript",
  "main": "index.ts",
  "bin": {
    "llang": "./dist/index.js"
  },
  "scripts": {
    "start": "ts-node index.ts",
    "parser": "peggy -o ./compiler/frontend/grammar/l-lang.js --format es ./compiler/frontend/grammar/l-lang.pegjs",
    "build": "tsc",
    "test": "./node_modules/.bin/jest"
  },
  "author": "Alex Sabaka",
  "license": "MIT",
  "nodemonConfig": {
    "ext": "*.ts,*.js,*.json,*.pegjs,*.lisp",
    "ignore": [
      "**/test/**",
      "**/docs/**"
    ]
  },
  "dependencies": {
    "@babel/types": "^7.25.8",
    "@types/node": "^22.7.4",
    "astring": "^1.9.0",
    "chalk": "^4.1.2",
    "cli-highlight": "^2.1.11",
    "commander": "^12.1.0",
    "highlight.js": "^11.10.0",
    "peggy": "^5.0.6",
    "pretty-format": "^29.7.0",
    "readline-sync": "^1.4.10",
    "recast": "^0.23.9",
    "source-map": "^0.7.4",
    "typescript": "^5.6.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.13",
    "@types/readline-sync": "^1.4.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "ts-jest": "^29.2.5"
  }
}
