-- mathematical constants --
pi          = 3.141592653589793
tau         = 6.283185307179586
e           = 2.718281828459045
phi         = 1.618033988749895
sqrt2       = 1.4142135623730951
1/sqrt2     = 0.7071067811865476
ln2         = 0.6931471805599453
ln10        = 2.302585092994046
log2(e)     = 1.4426950408889634
log10(e)    = 0.4342944819032518
gamma       = 0.5772156649015329
-- exact identities --
tau = 2*pi          : true
sqrt2 = 2*(1/sqrt2) : true
phi^2 = phi+1       : true
-- reciprocal logs (within 2 ULP) --
log2(e)*ln2   ~ 1   : true
log10(e)*ln10 ~ 1   : true
-- IEEE-754 boundaries --
epsilon     = 2.220446049250313e-16
max_value   = 1.7976931348623157e+308
min_normal  = 2.2250738585072014e-308
+inf        = Infinity
-inf        = -Infinity
nan         = NaN
-- boundary properties --
1+eps == 1          : false
1+eps/2 == 1        : true
max*2 = +inf        : true
max < +inf          : true
-inf < 0            : true
min_normal > 0      : true
nan == nan          : false
