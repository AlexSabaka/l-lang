-- integral of x^2 on [0,1] = 1/3 --
trapezoid n=100  = 0.33335
simpson   n=100  = 0.333333
adaptive  1e-9   = 0.333333
-- integral of sin on [0,pi] = 2 --
trapezoid n=1000 = 1.999998
simpson   n=100  = 2
adaptive  1e-9   = 2
-- Simpson is EXACT for cubics: integral of x^3 on [0,2] = 4 --
simpson   n=2    = 4
trapezoid n=2    = 5
-- root of x^2-2 = sqrt(2) = 1.414214 --
bisect x = 1.414214 conv = true
newton x = 1.414214 conv = true
secant x = 1.414214 conv = true
newton faster than bisect = true
secant faster than bisect = true
bisect iters <= 60        = true
-- root of x^3-x-2 = 1.521380 --
bisect x = 1.52138 conv = true
newton x = 1.52138 conv = true
-- failure modes return converged=#f, never a trap --
newton x^2+1 (no root) conv = false
newton from f'=0 spot  conv = false
bisect no sign change  conv = false
